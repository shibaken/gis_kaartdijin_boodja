{ 
    "wmsLayer": {
        "name":	"{{name|escapejs}}",
        "description":	"{{description|escapejs}}",
        {% if native_name %}"nativeName": "{{native_name|escapejs}}",{% endif %}
        {% if title %}"title": "{{title|escapejs}}",{% endif %}
        {% if abstract %}"abstract": "{{abstract|escapejs}}",{% endif %}
        {% if override_bbox %}
        "nativeCRS": "{{native_crs|escapejs}}",
        "srs": "{{crs|escapejs}}",
        "nativeBoundingBox": {
            "minx": {{ nativeBoundingBox.minx }},
            "maxx": {{ nativeBoundingBox.maxx }},
            "miny": {{ nativeBoundingBox.miny }},
            "maxy": {{ nativeBoundingBox.maxy }},
            "crs": "{{ nativeBoundingBox.crs|escapejs }}"
          },
          "latLonBoundingBox": {
            "minx": {{ latLonBoundingBox.minx }},
            "maxx": {{ latLonBoundingBox.maxx }},
            "miny": {{ latLonBoundingBox.miny }},
            "maxy": {{ latLonBoundingBox.maxy }},
            "crs": "{{ latLonBoundingBox.crs|escapejs }}"
          },
        {% endif %}
        "enabled": {{ enabled|yesno:"true,false" }},
        "keywords": [
            {% for k in keywords %}
                {
                    "string": "{{ k|escapejs }}"
                }
            {% endfor %}
        ]
        
    }
}