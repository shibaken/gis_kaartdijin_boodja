{
    "wmsStore" : {
        "name":	"{{name|escapejs}}",
        "description":	{{description}}, 
        "type": "WMS",
        "enabled":	{{ enabled|yesno:"true,false" }},    
        "capabilitiesURL":	"{{capability_url|escapejs}}",
        {% if username %}"user":	"{{username|escapejs}}",{% endif %}
        {% if password %}"password" :	"{{password|escapejs}}",{% endif %}
        "maxConnections":	"{{geoserver_setting.max_connections}}",    
        "readTimeout":	"{{geoserver_setting.read_timeout}}",
        "connectTimeout": "{{geoserver_setting.connect_timeout}}",
        "metadata": {}
    }
}