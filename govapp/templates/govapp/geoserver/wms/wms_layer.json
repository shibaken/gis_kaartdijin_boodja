{ 
    "wmsLayer": {
        "name": "{{ name|escape }}",
        "description": "{{ description|escape }}",
        "nativeName": "{{ native_name|escape }}",
        "title": "{{ title|escape }}",
        "abstract": "{{ abstract|escape }}",
        
        "srs": "{{ crs|escape }}",
        "nativeBoundingBox": {
            "minx": {{ nativeBoundingBox.minx|default:"112.9" }},
            "maxx": {{ nativeBoundingBox.maxx|default:"129.0" }},
            "miny": {{ nativeBoundingBox.miny|default:"-35.2" }},
            "maxy": {{ nativeBoundingBox.maxy|default:"-13.5" }},
            "crs": "{{ nativeBoundingBox.crs|escape }}"
        },
        "latLonBoundingBox": {
            "minx": {{ latLonBoundingBox.minx|default:"112.9" }},
            "maxx": {{ latLonBoundingBox.maxx|default:"129.0" }},
            "miny": {{ latLonBoundingBox.miny|default:"-35.2" }},
            "maxy": {{ latLonBoundingBox.maxy|default:"-13.5" }},
            "crs": "EPSG:4326"
        },
        
        "enabled": {{ enabled|yesno:"true,false" }},
        "keywords": {
            "string": [
                {% for k in keywords %}
                    "{{ k|escape }}"{% if not forloop.last %},{% endif %}
                {% endfor %}
            ]
        }
    }
}