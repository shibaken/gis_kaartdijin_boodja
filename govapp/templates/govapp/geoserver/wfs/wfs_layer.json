{% load json_filters %}
{ 
    "featureType": {
        "name": {{ name|json_string }},
        "description": {{ description|json_string }},
        {% if native_name %}"nativeName": {{ native_name|json_string }},{% endif %}
        {% if title %}"title": {{ title|json_string }},{% endif %}
        {% if abstract %}"abstract": {{ abstract|json_string }},{% endif %}
        
        {% if override_bbox %}
        "nativeCRS": {{ native_crs|json_string }},
        "srs": {{ crs|json_string }},
        "nativeBoundingBox": {
            "minx": {{ nativeBoundingBox.minx }},
            "maxx": {{ nativeBoundingBox.maxx }},
            "miny": {{ nativeBoundingBox.miny }},
            "maxy": {{ nativeBoundingBox.maxy }},
            "crs": {{ nativeBoundingBox.crs|json_string }}
        },
        "latLonBoundingBox": {
            "minx": {{ latLonBoundingBox.minx }},
            "maxx": {{ latLonBoundingBox.maxx }},
            "miny": {{ latLonBoundingBox.miny }},
            "maxy": {{ latLonBoundingBox.maxy }},
            "crs": "EPSG:4326"
        },
        {% endif %}
        
        "enabled": {{ enabled|yesno:"true,false" }},
        "keywords": [
            {% for k in keywords %}
                {
                    "string": {{ k|json_string }}
                }{% if not forloop.last %},{% endif %}
            {% endfor %}
        ]
    }
}